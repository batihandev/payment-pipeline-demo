{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "isolatedModules": true,
    "paths": {
      "@app/chain": ["./libs/chain/src"],
      "@app/chain/*": ["./libs/chain/src/*"],
      "@testing/chain/*": ["./libs/chain/testing/*"],
      "@app/config": ["./libs/config/src"],
      "@app/config/*": ["./libs/config/src/*"],
      "@testing/config/*": ["./libs/config/testing/*"],
      "@app/core": ["./libs/core/src"],
      "@app/core/*": ["./libs/core/src/*"],
      "@app/db": ["./libs/db/src"],
      "@app/db/*": ["./libs/db/src/*"],
      "@testing/db/*": ["./libs/db/testing/*"],
      "@app/events": ["./libs/events/src"],
      "@app/events/*": ["./libs/events/src/*"],
      "@app/logging": ["./libs/logging/src"],
      "@app/logging/*": ["./libs/logging/src/*"],
      "@app/orders": ["./libs/orders/src"],
      "@app/orders/*": ["./libs/orders/src/*"],
      "@app/queues": ["./libs/queues/src"],
      "@app/queues/*": ["./libs/queues/src/*"],
      "@app/redis": ["./libs/redis/src"],
      "@app/redis/*": ["./libs/redis/src/*"],
      "@app/stripe": ["./libs/stripe/src"],
      "@app/stripe/*": ["./libs/stripe/src/*"],
      "@testing/stripe/*": ["./libs/stripe/testing/*"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "libs/**/*.ts",
    "scripts/**/*.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules", "dist", "libs/db/generated"]
}
