{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api",
  "sourceRoot": "apps/api/src",
  "compilerOptions": {
    "builder": "tsc",
    "deleteOutDir": true,
    "tsConfigPath": "apps/api/tsconfig.app.json"
  },
  "projects": {
    "buyer": {
      "type": "application",
      "root": "apps/buyer",
      "entryFile": "main",
      "sourceRoot": "apps/buyer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/buyer/tsconfig.app.json"
      }
    },
    "tracker": {
      "type": "application",
      "root": "apps/tracker",
      "entryFile": "main",
      "sourceRoot": "apps/tracker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/tracker/tsconfig.app.json"
      }
    },
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "db": {
      "type": "library",
      "root": "libs/db",
      "entryFile": "index",
      "sourceRoot": "libs/db/src",
      "compilerOptions": {
        "tsConfigPath": "libs/db/tsconfig.lib.json"
      }
    },
    "config": {
      "type": "library",
      "root": "libs/config",
      "entryFile": "index",
      "sourceRoot": "libs/config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/config/tsconfig.lib.json"
      }
    },
    "chain": {
      "type": "library",
      "root": "libs/chain",
      "entryFile": "index",
      "sourceRoot": "libs/chain/src",
      "compilerOptions": {
        "tsConfigPath": "libs/chain/tsconfig.lib.json"
      }
    },
    "core": {
      "type": "library",
      "root": "libs/core",
      "entryFile": "index",
      "sourceRoot": "libs/core/src",
      "compilerOptions": {
        "tsConfigPath": "libs/core/tsconfig.lib.json"
      }
    },
    "events": {
      "type": "library",
      "root": "libs/events",
      "entryFile": "index",
      "sourceRoot": "libs/events/src",
      "compilerOptions": {
        "tsConfigPath": "libs/events/tsconfig.lib.json"
      }
    }
  }
}
