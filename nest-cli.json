{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api",
  "sourceRoot": "apps/api/src",
  "compilerOptions": {
    "builder": "tsc",
    "deleteOutDir": true,
    "tsConfigPath": "apps/api/tsconfig.app.json"
  },
  "projects": {
    "buyer": {
      "type": "application",
      "root": "apps/buyer",
      "entryFile": "main",
      "sourceRoot": "apps/buyer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/buyer/tsconfig.app.json"
      }
    },
    "tracker": {
      "type": "application",
      "root": "apps/tracker",
      "entryFile": "main",
      "sourceRoot": "apps/tracker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/tracker/tsconfig.app.json"
      }
    },
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "scripts": {
      "type": "application",
      "root": "scripts",
      "entryFile": "stripe-setup",
      "sourceRoot": "scripts",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.scripts.json"
      }
    }
  }
}
