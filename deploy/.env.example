# Settings for the deploy stack (deploy/compose.yaml). Copy to deploy/.env on
# the server and replace every placeholder. deploy/.env is never committed.

# Image repository and tag. deploy.sh writes IMAGE_TAG on each deploy.
IMAGE=ghcr.io/batihandev/payment-pipeline-demo
IMAGE_TAG=replace-with-commit-sha

# "tunnel" starts the Cloudflare Tunnel connector; leave it empty to run
# without one, as on a machine with no tunnel.
COMPOSE_PROFILES=tunnel
# Token of the remote-managed tunnel (Cloudflare Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=replace-with-tunnel-token

# Passwords for the stack's own Postgres and Redis. They go into connection
# URLs, so use URL-safe characters, for example `openssl rand -hex 24`.
POSTGRES_PASSWORD=replace-with-database-password
REDIS_PASSWORD=replace-with-redis-password

# Chain: Base Sepolia and its USDC contract.
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# The deploy's own buyer and shop wallets (`pnpm wallets:new`), not the
# development ones: a shared buyer key races for nonces.
BUYER_PRIVATE_KEY=replace-with-0x-buyer-private-key
SHOP_PRIVATE_KEY=replace-with-0x-shop-private-key
BUYER_ADDRESS=replace-with-0x-buyer-address
SHOP_ADDRESS=replace-with-0x-shop-address

# Signs the tracker's shop notices to the API; at least 32 characters,
# for example `openssl rand -hex 32`.
NOTICE_SECRET=replace-with-notice-secret

# Comma-separated origins of the pages that call the API (CORS), each a bare
# https origin with no path.
WEB_ORIGIN=https://example.com,https://www.example.com

# The deploy's own Stripe sandbox: its test secret key (sk_test_ only), and the
# signing secret of its Dashboard webhook endpoint.
STRIPE_SECRET_KEY=sk_test_replace-with-sandbox-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-endpoint-signing-secret
