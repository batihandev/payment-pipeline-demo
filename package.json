{
  "name": "testnet-payments",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "lint": "eslint . && tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "jest --runInBand && pnpm --filter web test",
    "build": "pnpm prisma generate && nest build buyer && nest build tracker && nest build api && tsc -p tsconfig.libs.json && pnpm --filter web build",
    "start:buyer": "node --env-file=.env dist/apps/buyer/apps/buyer/src/main.js",
    "start:tracker": "node --env-file=.env dist/apps/tracker/apps/tracker/src/main.js",
    "start:api": "node --env-file=.env dist/apps/api/apps/api/src/main.js",
    "dev:buyer": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start buyer --watch",
    "dev:tracker": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start tracker --watch",
    "dev:api": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start api --watch",
    "dev:web": "pnpm --filter web dev",
    "prisma": "node --env-file-if-exists=.env node_modules/prisma/build/index.js",
    "db:migrate": "docker compose up -d --wait && pnpm prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "12.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
