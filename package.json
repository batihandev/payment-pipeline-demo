{
  "name": "payment-pipeline-demo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "lint": "eslint . && tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "node --experimental-vm-modules --env-file-if-exists=.env node_modules/jest/bin/jest.js --runInBand && pnpm --filter web test",
    "test:local": "docker compose up -d --wait && DATABASE_URL=postgresql://testnet:local_testnet@127.0.0.1:55432/testnet_payments pnpm prisma migrate deploy && TEST_DATABASE_URL=postgresql://testnet:local_testnet@127.0.0.1:55432/testnet_payments TEST_REDIS_URL=redis://127.0.0.1:56379/1 pnpm test",
    "build": "pnpm prisma generate && nest build buyer && nest build tracker && nest build api && tsc -p tsconfig.libs.json && pnpm --filter web build",
    "start:buyer": "node --env-file=.env dist/apps/buyer/apps/buyer/src/main.js",
    "start:tracker": "node --env-file=.env dist/apps/tracker/apps/tracker/src/main.js",
    "start:api": "node --env-file=.env dist/apps/api/apps/api/src/main.js",
    "dev:buyer": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start buyer --watch",
    "dev:tracker": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start tracker --watch",
    "dev:api": "node --env-file=.env node_modules/@nestjs/cli/bin/nest.js start api --watch",
    "dev:web": "pnpm --filter web dev",
    "prisma": "node --env-file-if-exists=.env node_modules/prisma/build/index.js",
    "db:migrate": "docker compose up -d --wait && pnpm prisma migrate dev",
    "wallets:new": "tsx scripts/wallets-new.ts",
    "stripe:setup": "tsx --env-file-if-exists=.env scripts/stripe-setup.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.4.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "23.0.1",
    "viem": "2.57.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
