generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  open
  paid
  expired
}

enum OrderSource {
  schedule
  visitor
}

enum PaymentRail {
  chain
  card
}

enum PaymentProvider {
  chain
  stripe
}

enum PaymentStage {
  sent
  received
  confirming
  processing
  settled
  notified
  failed
}

model Order {
  id                String       @id @default(uuid()) @db.Uuid
  item              String
  price             BigInt
  expectedAmount    BigInt       @map("expected_amount")
  status            OrderStatus  @default(open)
  source            OrderSource
  rail              PaymentRail  @default(chain)
  customerId        String?      @map("customer_id") @db.Uuid
  customer          Customer?    @relation(fields: [customerId], references: [id])
  nonce             BigInt?
  signedTransaction String?      @map("signed_transaction")
  transactionHash   String?      @map("transaction_hash")
  sendState         String       @default("pending") @map("send_state")
  sendAttempts      Int          @default(0) @map("send_attempts")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(3)
  payments          Payment[]
  events            OrderEvent[]

  @@index([expectedAmount, createdAt])
  @@index([customerId])
  @@map("orders")
}

model Customer {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  chainAddress          String?  @map("chain_address")
  stripeCustomerId      String?  @unique @map("stripe_customer_id")
  stripePaymentMethodId String?  @map("stripe_payment_method_id")
  cardBrand             String?  @map("card_brand")
  cardLast4             String?  @map("card_last4")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  orders                Order[]

  @@map("customers")
}

model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@map("stripe_events")
}

model DailyBudget {
  day            DateTime @id @db.Date
  targetCount    Int      @map("target_count")
  targetAmount   BigInt   @map("target_amount")
  reservedCount  Int      @default(0) @map("reserved_count")
  reservedAmount BigInt   @default(0) @map("reserved_amount")

  @@map("daily_budgets")
}

model ScanGap {
  id            String    @id @default(uuid()) @db.Uuid
  fromBlock     BigInt    @map("from_block")
  toBlock       BigInt    @map("to_block")
  errorCategory String    @map("error_category")
  attempts      Int       @default(0)
  nextRetryAt   DateTime  @map("next_retry_at") @db.Timestamptz(3)
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(3)

  @@index([resolvedAt, nextRetryAt])
  @@map("scan_gaps")
}

model Payment {
  id              String          @id @default(uuid()) @db.Uuid
  provider        PaymentProvider
  externalKey     String          @map("external_key")
  orderId         String?         @map("order_id") @db.Uuid
  order           Order?          @relation(fields: [orderId], references: [id])
  amount          BigInt
  stage           PaymentStage    @default(received)
  confirmations   Int             @default(0)
  chainId         Int?            @map("chain_id")
  blockNumber     BigInt?         @map("block_number")
  blockHash       String?         @map("block_hash")
  transactionHash String?         @map("transaction_hash")
  logIndex        Int?            @map("log_index")
  fromAddress     String?         @map("from_address")
  receiptUrl      String?         @map("receipt_url")
  donation        Boolean         @default(false)
  final           Boolean         @default(false)
  sentAt          DateTime?       @map("sent_at") @db.Timestamptz(3)
  receivedAt      DateTime?       @map("received_at") @db.Timestamptz(3)
  confirmingAt    DateTime?       @map("confirming_at") @db.Timestamptz(3)
  processingAt    DateTime?       @map("processing_at") @db.Timestamptz(3)
  settledAt       DateTime?       @map("settled_at") @db.Timestamptz(3)
  notifiedAt      DateTime?       @map("notified_at") @db.Timestamptz(3)
  finalAt         DateTime?       @map("final_at") @db.Timestamptz(3)
  ledgerEntry     LedgerEntry?
  notice          Notice?
  incidents       Incident[]
  events          PaymentEvent[]

  @@unique([provider, externalKey])
  @@unique([chainId, transactionHash, logIndex])
  @@index([orderId])
  @@map("payments")
}

model LedgerEntry {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @unique @map("payment_id") @db.Uuid
  payment   Payment  @relation(fields: [paymentId], references: [id])
  amount    BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("ledger_entries")
}

model Incident {
  id           String   @id @default(uuid()) @db.Uuid
  kind         String
  whatHappened String   @map("what_happened")
  howHandled   String   @map("how_handled")
  paymentId    String?  @map("payment_id") @db.Uuid
  payment      Payment? @relation(fields: [paymentId], references: [id])
  fromBlock    BigInt?  @map("from_block")
  toBlock      BigInt?  @map("to_block")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([paymentId])
  @@map("incidents")
}

model Cursor {
  name        String   @id
  blockNumber BigInt   @map("block_number")
  blockHash   String   @map("block_hash")
  /// Set only when the scanner stores a higher block number.
  advancedAt  DateTime @default(now()) @map("advanced_at") @db.Timestamptz(3)

  @@map("cursors")
}

model Notice {
  paymentId   String    @id @map("payment_id") @db.Uuid
  payment     Payment   @relation(fields: [paymentId], references: [id])
  attempts    Int       @default(0)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)

  @@map("notices")
}

model WalletNonce {
  address   String @id
  nextNonce BigInt @map("next_nonce")

  @@map("wallet_nonces")
}

model Sweep {
  id                String   @id
  amount            BigInt
  nonce             BigInt?
  signedTransaction String?  @map("signed_transaction")
  transactionHash   String?  @map("transaction_hash")
  sendAttempts      Int      @default(0) @map("send_attempts")
  sendState         String   @default("pending") @map("send_state")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("sweeps")
}

model OrderEvent {
  id          BigInt    @id @default(autoincrement())
  orderId     String    @map("order_id") @db.Uuid
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([publishedAt, id])
  @@index([orderId])
  @@map("order_events")
}

model PaymentEvent {
  id          BigInt    @id @default(autoincrement())
  paymentId   String    @map("payment_id") @db.Uuid
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([publishedAt, id])
  @@map("payment_events")
}
